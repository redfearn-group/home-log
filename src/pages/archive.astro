---
import Base from "../layouts/Base.astro";
import { getArchivedItems, itemLabel } from "../lib/data";
import { withBase } from "../lib/url";

const items = getArchivedItems();
---
<Base title="Archive">
  <p><a href={withBase("/")}>← Dashboard</a></p>
  <h2>Archived items</h2>
  <p class="muted">Replaced or removed items — full history is kept for reference, just off the main dashboard.</p>

  {items.length === 0 && <p class="muted">Nothing archived yet.</p>}

  <ul class="pill-list">
    {items.map((i) => (
      <li class="card">
        <a href={withBase(`/items/${i.slug}`)}>{itemLabel(i)}</a>
      </li>
    ))}
  </ul>
</Base>
